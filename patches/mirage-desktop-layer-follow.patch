@@ -878,2 +884,35 @@ void StopApplicationOnMainThread() {
 
+extern "C" bool SceneRendererMacDesktopMoveToDisplay(void* handle,
+                                                       std::uint32_t display_id) {
+    auto* host = static_cast<MacDesktopHost*>(handle);
+    if (host == nullptr || !host->follow_focus || display_id == 0) return false;
+    __block bool moved = false;
+    auto move = ^{
+      NSScreen* target = ResolveScreen(display_id);
+      if (host->window == nil || target == nil ||
+          host->window.level != CGWindowLevelForKey(kCGDesktopWindowLevelKey) ||
+          !host->window.ignoresMouseEvents) return;
+      if (host->display_id == display_id) {
+          moved = true;
+          return;
+      }
+
+      // Clear the old display before changing the target. A new presented
+      // frame must pass the existing activation geometry check before reveal.
+      host->window.alphaValue = 0.0;
+      [host->window orderOut:nil];
+      [CATransaction flush];
+      host->display_id = display_id;
+      host->activation_confirmed.store(false);
+      host->activation_frame_pending.store(host->activation_requested.load());
+      if (!NormalizeGeometry(host)) return; // Remain hidden on failure.
+      [host->window orderFrontRegardless];
+      [CATransaction flush];
+      moved = true;
+    };
+    if (NSThread.isMainThread) move();
+    else dispatch_sync(dispatch_get_main_queue(), move);
+    return moved;
+}
