+void WireLightIntensityScript(ParseContext& context, SceneNode* node, SceneLight* light,
+                              const wpscene::FieldBindings& fb) {
+    auto binding = fb.scripts.find("intensity");
+    if (binding == fb.scripts.end()) return;
+    const auto& sb = binding->second;
+    auto& ss = EnsureScriptScene(context);
+    auto& rt = ss.runtime();
+    std::string sha = utils::genSha1(std::span<const char>(sb.source));
+    auto* fs = rt.MakeFieldScript(sb.source, sha, script::FieldKind::Scalar,
+                                  ScriptPropertiesForField(context, "intensity", sb),
+                                  ScriptInitialValueForField("intensity", sb.initial_value), node);
+    if (! fs) return;
+    RegisterFieldScriptMetadata(context, node, fs);
+    ss.AddActuator({ fs, [light](const script::ScriptValue& value) {
+                        auto next = ScriptValueAsFloat(value);
+                        if (next && std::isfinite(*next) && *next >= 0.0f)
+                            light->setIntensity(*next);
+                    } });
+}
