diff --git a/SceneRenderer/Tests/ScriptCompatibilityRegression.cpp b/SceneRenderer/Tests/ScriptCompatibilityRegression.cpp
index 5810114..bf18c9b 100644
--- a/SceneRenderer/Tests/ScriptCompatibilityRegression.cpp
+++ b/SceneRenderer/Tests/ScriptCompatibilityRegression.cpp
@@ -1579,6 +1579,43 @@ void TestFieldScriptUpdateDetection() {
           "a toggling visible binding exports update");
 }
 
+void TestTransformFieldReadsLiveNodeValue() {
+    sr::Scene scene;
+    auto body = rstd::sync::Arc<sr::SceneNode>::make(
+        Eigen::Vector3f::Zero(), Eigen::Vector3f::Ones(), Eigen::Vector3f::Zero(), "body");
+    scene.sceneGraph->AppendChild(body.clone());
+
+    sr::script::JsRuntime runtime;
+    auto* driver = runtime.MakeFieldScript(
+        R"JS(
+            let size = 0.25;
+            export function update() {
+                thisScene.getLayer('body').scale = {x: size, y: size, z: size};
+                size += 0.25;
+                return true;
+            }
+        )JS",
+        "test/transform_driver", sr::script::FieldKind::Bool,
+        Parse("{}"), Parse("true"), scene.sceneGraph.as_ptr());
+    auto* mirror = runtime.MakeFieldScript(
+        "export function update(value) { return value; }",
+        "test/transform_mirror", sr::script::FieldKind::Vec3,
+        Parse("{}"), Parse("\"1 1 1\""), body.as_ptr());
+    Check(driver != nullptr && mirror != nullptr, "transform driver and mirror compile");
+    if (!driver || !mirror) return;
+    runtime.SetLiveTransformInput(*mirror, sr::script::NodeTransformTarget::Scale);
+    runtime.SetSceneRoot(scene.sceneGraph.as_ptr());
+
+    runtime.TickAll();
+    const auto* first = std::get_if<sr::script::Vec3Value>(&mirror->last_value());
+    Check(first && std::abs(first->x - 0.25) < 0.001,
+          "mirror reads a scale written earlier in the same tick");
+    runtime.TickAll();
+    const auto* second = std::get_if<sr::script::Vec3Value>(&mirror->last_value());
+    Check(second && std::abs(second->x - 0.5) < 0.001,
+          "mirror does not reuse its previous return value");
+}
