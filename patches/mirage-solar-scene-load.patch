+// The live solar-system wallpaper combines a very strong point light with
+// near-black ambient light. Identify its model set before touching materials;
+// unrelated scenes retain their authored shader path.
+bool IsLiveSolarSystemScene(const Json& json) {
+    auto objects = json.get("objects");
+    if (objects.is_none()) return false;
+    auto array = (*objects)->as_array();
+    if (array.is_none()) return false;
+    unsigned found = 0;
+    for (const auto& object : **array) {
+        std::string name;
+        std::string model;
+        if (! sr::GetJsonValue(object, "name", name, false) ||
+            ! sr::GetJsonValue(object, "model", model, false))
+            continue;
+        if (name == "p1" && model == "models/128qt1/128qt1.mdl") found |= 1u << 0;
+        if (name == "p2" && model == "models/128qt2/128qt2.mdl") found |= 1u << 1;
+        if (name == "p4" && model == "models/128qt4/128qt4.mdl") found |= 1u << 2;
+        if (name == "p5" && model == "models/128qt5/128qt5.mdl") found |= 1u << 3;
+        if (name == "p6n" && model == "models/128qt6/128qt6.mdl") found |= 1u << 4;
+        if (name == "p7" && model == "models/128qt7/128qt7.mdl") found |= 1u << 5;
+        if (name == "p8" && model == "models/128qt8/128qt8.mdl") found |= 1u << 6;
+    }
+    return found == 0x7fu;
+}
